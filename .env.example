# --- Postgres ---
# Connection string for your Postgres database (e.g. from Neon, Railway, or your own server)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Firebase Admin (server-side, used in lib/firebase-admin.ts) ---
# From Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Firebase Client (browser-side, used wherever you initialize Firebase Auth in the frontend) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
